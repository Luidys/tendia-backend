# Cadena de conexión a Postgres (Neon, Supabase, Railway, RDS, etc.)
DATABASE_URL="postgresql://usuario:password@host:5432/tendia?sslmode=require"

# Clave secreta para firmar los tokens de sesión (JWT). OBLIGATORIA y debe ser
# fuerte en producción (el servidor se niega a arrancar si no lo es).
# Genera una real con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="cambia-esto-por-una-clave-larga-y-secreta"

# Cuánto dura una sesión antes de tener que iniciar sesión de nuevo.
JWT_EXPIRES_IN="12h"

PORT=4000

# En tu servidor de producción (Railway/Render) define:  NODE_ENV=production
# Eso activa: cabeceras de seguridad, CORS restringido, y bloquea arrancar
# con una clave débil o con la base de datos de pruebas.
NODE_ENV="development"

# URL(s) exactas desde donde se puede llamar a esta API, separadas por coma
# (dónde publiques tendia-mini-agente.html). Ej:
# CORS_ORIGINS="https://tu-usuario.github.io,https://tendia.app"
CORS_ORIGINS=""

# --- Automatización con WhatsApp / Instagram (Meta) ---
# Token que TÚ inventas y configuras también en el panel de Meta al crear
# el webhook (sirve para que Meta verifique que la URL es tuya).
META_VERIFY_TOKEN="inventa-un-token-largo-aqui"

# "App Secret" de tu app de Meta (Configuración básica de la app en
# developers.facebook.com). Con esto el servidor verifica que cada mensaje
# entrante realmente viene de Meta y no de un impostor — SIN esto, cualquiera
# que descubra tu URL de webhook podría fabricar pedidos o pagos falsos.
META_APP_SECRET=""

# Token de acceso permanente de tu app de Meta Business (WhatsApp Cloud API).
# Mientras no lo configures, el sistema funciona en "modo simulación":
# no envía mensajes reales, pero puedes probar toda la lógica del agente.
WHATSAPP_ACCESS_TOKEN=""

# Token de acceso de tu página de Instagram conectada (Meta Graph API).
INSTAGRAM_ACCESS_TOKEN=""

# --- Recuperación de contraseña (correo) ---
# Mientras no configures esto, "olvidé mi contraseña" funciona en modo
# simulación: el token de recuperación se devuelve directo en la respuesta
# en vez de enviarse por correo (para poder probar sin servidor de correo).
# Con Gmail: activa la verificación en 2 pasos en tu cuenta y genera una
# "contraseña de aplicación" en myaccount.google.com/apppasswords — esa
# es la que va en SMTP_PASS (NO tu contraseña normal de Gmail).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="tu-correo@gmail.com"
SMTP_PASS=""
MAIL_FROM="Tendia <tu-correo@gmail.com>"

# URL pública de tu frontend, para armar el enlace que se envía por correo
# (ej: https://tu-usuario.github.io/tendia o donde publiques el HTML).
FRONTEND_URL="http://localhost"

# --- Límites de intentos (anti fuerza bruta / anti abuso) ---
# Puedes ajustar estos números; los valores por defecto son razonables.
# RATE_LIMIT_AUTH_MAX=30           # login/registro/reset por IP cada 15 min
# RATE_LIMIT_RECOVER_MAX=5         # "olvidé mi clave" por IP cada 60 min
# RATE_LIMIT_PAYMENTS_MAX=30       # declarar/aprobar/rechazar pagos por IP cada 15 min
# RATE_LIMIT_GENERAL_MAX=1000      # tope general por IP cada 15 min
# LOGIN_MAX_FALLIDOS=5             # intentos fallidos antes de bloquear una cuenta 15 min
# Solo para desarrollo: quita los límites por completo (se ignora si NODE_ENV=production)
# RATE_LIMIT_DISABLED=1
